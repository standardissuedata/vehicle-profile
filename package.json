{
  "name": "@standardissuedata/vehicle-profile",
  "version": "0.1.0",
  "description": "Look up public US vehicle identity, safety and fuel economy data from a VIN.",
  "type": "module",
  "license": "MIT",
  "author": "Standard Issue Data",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/standardissuedata/vehicle-profile.git"
  },
  "homepage": "https://github.com/standardissuedata/vehicle-profile#readme",
  "bugs": { "url": "https://github.com/standardissuedata/vehicle-profile/issues" },
  "keywords": ["vin", "vehicle", "nhtsa", "epa", "fuel-economy", "cli", "typescript"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": { "node": ">=22" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": { "vehicle-profile": "./bin/vehicle-profile.mjs" },
  "files": ["dist", "bin", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test",
    "test:package": "node scripts/check-package.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": { "typescript": "5.9.3" }
}
